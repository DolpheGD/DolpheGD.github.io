---
layout: null
permalink: /search.json
---
[
{% assign all_items = site.classified | concat: site.chronicles %}
{% assign parent_slugs = all_items | map: "group_of" | compact | uniq %}
{% for item in all_items %}
  {% assign is_guessable = true %}
  {% if item.hero or item.preview == nil or item.game == false %}{% assign is_guessable = false %}{% endif %}
  {% if parent_slugs contains item.slug %}{% assign is_guessable = false %}{% endif %}
  {
    "title": {{ item.title | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "icon": {{ item.icon | default: "📄" | jsonify }},
    "section": {{ item.section | jsonify }},
    "preview": {% if item.preview %}{{ item.preview | relative_url | jsonify }}{% else %}null{% endif %},
    "excerpt": {{ item.description | default: item.content | strip_html | strip_newlines | strip | truncate: 200 | jsonify }},
    "guessable": {{ is_guessable }},
    "game_alias_of": {{ item.game_alias_of | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
